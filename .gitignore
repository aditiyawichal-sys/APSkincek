# Dependencies
node_modules/
**/node_modules/
vendor/

# Environment and sensitive configuration files
SkinCheck/config/ai_config.json
SkinCheck/config/fonnte_config.json
SkinCheck/config/api.php
.env
.env.*
*.env

# User uploaded media & files (preserves privacy)
SkinCheck/storage/uploads/*
!SkinCheck/storage/uploads/.gitkeep
SkinCheck/public/storage/uploads/*
!SkinCheck/public/storage/uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
__pycache__/
*.pyc

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.vscode/
.idea/
*.suo
*.user

